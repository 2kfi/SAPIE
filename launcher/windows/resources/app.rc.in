#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "sapie.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @SAPIE_VERSION_RC@
PRODUCTVERSION @SAPIE_VERSION_RC@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "SAPIE"
      VALUE "FileDescription", "SAPIE for Windows launcher"
      VALUE "FileVersion", "@SAPIE_VERSION@"
      VALUE "InternalName", "sapie-launcher"
      VALUE "LegalCopyright", "SAPIE contributors. Non-commercial."
      VALUE "OriginalFilename", "SAPIE.exe"
      VALUE "ProductName", "SAPIE for Windows"
      VALUE "ProductVersion", "@SAPIE_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
